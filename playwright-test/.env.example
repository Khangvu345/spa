# Sao chép file này thành `.env` rồi chỉnh lại cho đúng môi trường của bạn.
# Các test e2e đọc các biến dưới đây (playwright.config.ts tự nạp file .env).

# URL gốc của frontend đang chạy (umi dev mặc định cổng 8000)
BASE_URL=http://localhost:8000

# Tài khoản ADMIN (khớp SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD bạn dùng khi seed BE)
ADMIN_EMAIL=admin@spa.local
ADMIN_PASSWORD=Admin@123456

# Tài khoản OPERATOR (Lễ tân + Thu ngân) — seed-staff mặc định
OPERATOR_EMAIL=operator@spa.local
OPERATOR_PASSWORD=Staff@123456

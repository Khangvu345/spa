# ============================================================
# Frontend env example — copy thành .env trước khi chạy.
# Chỉ các biến có tiền tố APP_CONFIG_ mới được inject vào FE
# (xem config/config.ts → define).
# ============================================================

# --- Backend Luna Spa (NestJS) ---
# URL gốc của backend. FE gọi /auth/login, /auth/me, /employees… từ đây.
# Mặc định BE dev chạy ở port 3000.
# LƯU Ý: file này chỉ phục vụ DEV (yarn start). Build deploy (yarn build:landing /
# build:admin) đã bake sẵn URL prod trong script ở package.json — cross-env luôn
# thắng .env nên không cần (và không thể) đổi URL prod qua file này.
APP_CONFIG_API_URL=http://localhost:3000/api/v1

# --- Cấu hình legacy của base-web-umi (không bắt buộc cho Luna Spa) ---
# Giữ lại vì code base còn import; có thể để rỗng nếu không dùng.
APP_CONFIG_IP_ROOT=http://localhost:3000/
APP_CONFIG_ONE_SIGNAL_ID=
APP_CONFIG_SENTRY_DSN=
APP_CONFIG_KEYCLOAK_AUTHORITY=
APP_CONFIG_PREFIX_OF_KEYCLOAK_CLIENT_ID=
APP_CONFIG_APP_VERSION=1.0.0

APP_CONFIG_CO_QUAN_CHU_QUAN='Luna Spa'
APP_CONFIG_TEN_TRUONG='Luna Spa'
APP_CONFIG_TIEN_TO_TRUONG=''
APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH='LUNA'
APP_CONFIG_PRIMARY_COLOR=#c47070

APP_CONFIG_URL_LANDING=
APP_CONFIG_URL_CONNECT=
APP_CONFIG_URL_CAN_BO=
APP_CONFIG_URL_DAO_TAO=
APP_CONFIG_URL_NHAN_SU=
APP_CONFIG_URL_TAI_CHINH=
APP_CONFIG_URL_CTSV=
APP_CONFIG_URL_QLKH=
APP_CONFIG_URL_VPS=
APP_CONFIG_URL_KHAO_THI=
APP_CONFIG_URL_CORE=
APP_CONFIG_URL_CSVC=
APP_CONFIG_URL_THU_VIEN=
APP_CONFIG_URL_QLVB=

APP_CONFIG_TITLE_LANDING=''
APP_CONFIG_TITLE_CONNECT=''
APP_CONFIG_TITLE_CAN_BO=''
APP_CONFIG_TITLE_DAO_TAO=''
APP_CONFIG_TITLE_NHAN_SU=''
APP_CONFIG_TITLE_TAI_CHINH=''
APP_CONFIG_TITLE_CTSV=''
APP_CONFIG_TITLE_QLKH=''
APP_CONFIG_TITLE_VPS=''
APP_CONFIG_TITLE_KHAO_THI=''
APP_CONFIG_TITLE_CORE=''
APP_CONFIG_TITLE_CSVC=''
APP_CONFIG_TITLE_THU_VIEN=''
APP_CONFIG_TITLE_QLVB=''
